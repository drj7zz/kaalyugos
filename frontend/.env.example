# ── Kaalyug OS Frontend · Environment Variables ─────────────────────────────
# Copy this file to .env.local for local dev, or set in Vercel dashboard for production.

# Backend API base URL
# Local dev: http://localhost:10000/api
# Production: your Render backend URL
VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND.onrender.com/api
